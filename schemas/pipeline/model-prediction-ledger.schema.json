{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:model-prediction-ledger:1.0",
  "title": "Frozen encoder prediction ledger",
  "description": "One record per prepared sentence holding the raw span and relation scores an encoder emitted for a single training seed. The adapter deterministically transforms these scores into CODE-STRICT-1 candidates.",
  "type": "object",
  "required": [
    "protocol_id",
    "example_id",
    "training_seed",
    "predicted_spans",
    "predicted_relations"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "example_id": {"type": "string", "format": "uuid"},
    "training_seed": {"type": "integer", "minimum": 42, "maximum": 49},
    "predicted_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "type", "confidence"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "type": {"enum": ["Object", "Property", "Quality", "Value"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "predicted_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["head", "tail", "relation", "re_confidence"],
        "properties": {
          "head": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "tail": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "relation": {
            "enum": [
              "selection",
              "necessity",
              "part-of",
              "not-part-of",
              "equal",
              "greater",
              "greater-equal",
              "less",
              "less-equal"
            ]
          },
          "re_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
