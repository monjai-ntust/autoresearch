{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:prepared-code-accord-sentence:1.0",
  "title": "Prepared CODE-ACCORD sentence",
  "type": "object",
  "required": [
    "protocol_id",
    "dataset_id",
    "example_id",
    "source_document_id",
    "source_country",
    "split",
    "content",
    "processed_content",
    "words",
    "entities",
    "relations"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "dataset_id": {"const": "CODE-ACCORD-v1.0.0"},
    "example_id": {"type": "string", "format": "uuid"},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_country": {"enum": ["UK", "Finland"]},
    "split": {"enum": ["train", "development", "test"]},
    "content": {"type": "string", "minLength": 1},
    "processed_content": {"type": "string", "minLength": 1},
    "words": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entities": {"type": "array"},
    "relations": {"type": "array"}
  },
  "additionalProperties": false
}
