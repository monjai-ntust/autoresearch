{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:verifier-manifest:1.0",
  "title": "Phase B verifier-stage manifest",
  "type": "object",
  "required": [
    "protocol_id",
    "condition_id",
    "execution_mode",
    "status",
    "candidate_count",
    "warmup_candidate_count",
    "warmup_latency_observation_included",
    "verdict_count",
    "prompt_sha256",
    "model_manifest_sha256",
    "decoding_sha256",
    "inputs",
    "outputs"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "condition_id": {"enum": ["VER-SIMPLE", "VER-CORRECTIVE"]},
    "execution_mode": {"enum": ["dry-run", "live", "replay"]},
    "status": {"enum": ["planned", "completed"]},
    "candidate_count": {"type": "integer", "minimum": 1},
    "warmup_candidate_count": {"enum": [0, 1]},
    "warmup_latency_observation_included": {"const": false},
    "verdict_count": {"type": "integer", "minimum": 0},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decoding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "outputs": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  },
  "additionalProperties": false
}
