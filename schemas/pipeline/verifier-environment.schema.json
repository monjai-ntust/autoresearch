{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:verifier-environment:1.0",
  "title": "Phase B verifier environment manifest",
  "type": "object",
  "required": [
    "protocol_id",
    "condition_id",
    "execution_mode",
    "created_at_utc",
    "python",
    "platform",
    "hardware",
    "software",
    "ollama",
    "model"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "condition_id": {"enum": ["VER-SIMPLE", "VER-CORRECTIVE"]},
    "execution_mode": {"enum": ["dry-run", "live", "replay"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "python": {"type": "object"},
    "platform": {"type": "object"},
    "hardware": {"type": "object"},
    "software": {"type": "object"},
    "ollama": {"type": "object"},
    "model": {"type": "object"}
  },
  "additionalProperties": false
}
