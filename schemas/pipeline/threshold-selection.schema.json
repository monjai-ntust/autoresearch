{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:threshold-selection:1.0",
  "title": "Development-only confidence-threshold selection",
  "type": "object",
  "required": [
    "protocol_id",
    "selection_split",
    "objective",
    "tie_rule",
    "grid",
    "selected_threshold",
    "used_test_labels",
    "development_candidate_index_sha256",
    "development_gold_sha256",
    "split_manifest_sha256",
    "per_threshold"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "selection_split": {"const": "development"},
    "objective": {"const": "mean_per_seed_development_strict_triple_f1"},
    "tie_rule": {"const": "higher_threshold"},
    "grid": {
      "const": [
        0.0,
        0.05,
        0.1,
        0.15,
        0.2,
        0.25,
        0.3,
        0.35,
        0.4,
        0.45,
        0.5,
        0.55,
        0.6,
        0.65,
        0.7,
        0.75,
        0.8,
        0.85,
        0.9,
        0.95
      ]
    },
    "selected_threshold": {
      "enum": [
        0.0,
        0.05,
        0.1,
        0.15,
        0.2,
        0.25,
        0.3,
        0.35,
        0.4,
        0.45,
        0.5,
        0.55,
        0.6,
        0.65,
        0.7,
        0.75,
        0.8,
        0.85,
        0.9,
        0.95
      ]
    },
    "used_test_labels": {"const": false},
    "development_candidate_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_gold_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "per_threshold": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "threshold",
          "per_seed_development_strict_triple_f1",
          "mean_per_seed_development_strict_triple_f1"
        ],
        "properties": {
          "threshold": {"type": "number", "minimum": 0, "maximum": 0.95},
          "per_seed_development_strict_triple_f1": {
            "type": "object",
            "required": ["42", "43", "44", "45", "46", "47", "48", "49"],
            "additionalProperties": false,
            "patternProperties": {
              "^(42|43|44|45|46|47|48|49)$": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "mean_per_seed_development_strict_triple_f1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
