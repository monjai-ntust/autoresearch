{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:experiment-matrix:1.0",
  "title": "Phase B canonical experiment matrix",
  "type": "object",
  "required": [
    "matrix_revision",
    "protocol_id",
    "workflow_id",
    "matcher_id",
    "dataset_id",
    "split_id",
    "training_seeds",
    "conditions"
  ],
  "properties": {
    "matrix_revision": {"const": "PATH-A-MATRIX-1.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "workflow_id": {"const": "PATH-A-WORKFLOW-1.3"},
    "matcher_id": {"const": "CODE-STRICT-1"},
    "conditions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "status",
          "baseline_id",
          "verifier_mode",
          "candidate_decision",
          "end_to_end_emission",
          "claim_ids",
          "publication_targets"
        ],
        "properties": {
          "condition_id": {
            "enum": ["VER-RAW", "VER-CONFIDENCE", "VER-SIMPLE", "VER-CORRECTIVE"]
          },
          "status": {"enum": ["PRIMARY_REFERENCE", "PRIMARY"]},
          "baseline_id": {
            "type": ["string", "null"]
          },
          "verifier_mode": {"enum": ["none", "simple", "corrective"]},
          "candidate_decision": {"type": "string", "minLength": 1},
          "end_to_end_emission": {"type": "string", "minLength": 1},
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "publication_targets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
