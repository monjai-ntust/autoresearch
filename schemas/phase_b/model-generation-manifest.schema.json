{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:model-generation-manifest:1.0",
  "title": "Encoder candidate-generation stage manifest",
  "description": "Stage manifest emitted by phase_b.py model generate-candidates for both dry-run and replay executions. dry-run leaves candidates_output and the ledger-derived counts null; replay leaves generation_plan_output null.",
  "type": "object",
  "required": [
    "protocol_id",
    "matcher_id",
    "stage",
    "execution_mode",
    "status",
    "created_at_utc",
    "training_seed",
    "checkpoint",
    "inputs",
    "sentence_count",
    "ledger_sentence_count",
    "selected_entity_count",
    "candidate_count",
    "duplicate_candidate_collapsed",
    "generation_plan_output",
    "candidates_output"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "matcher_id": {"const": "CODE-STRICT-1"},
    "stage": {"const": "model-generate-candidates"},
    "execution_mode": {"enum": ["dry-run", "replay"]},
    "status": {"enum": ["planned", "completed"]},
    "created_at_utc": {"type": "string"},
    "training_seed": {"type": "integer", "minimum": 42, "maximum": 49},
    "checkpoint": {
      "type": "object",
      "required": ["sha256", "step", "split_manifest_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "step": {"type": "integer", "minimum": 1},
        "split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["prepared_sentences", "checkpoint_manifest", "prediction_ledger"],
      "properties": {
        "prepared_sentences": {"$ref": "#/$defs/input_reference"},
        "checkpoint_manifest": {"$ref": "#/$defs/input_reference"},
        "prediction_ledger": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/input_reference"}]
        }
      },
      "additionalProperties": false
    },
    "sentence_count": {"type": "integer", "minimum": 1},
    "ledger_sentence_count": {"type": ["integer", "null"], "minimum": 0},
    "selected_entity_count": {"type": ["integer", "null"], "minimum": 0},
    "candidate_count": {"type": "integer", "minimum": 0},
    "duplicate_candidate_collapsed": {"type": "integer", "minimum": 0},
    "generation_plan_output": {"type": ["string", "null"]},
    "candidates_output": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "input_reference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
