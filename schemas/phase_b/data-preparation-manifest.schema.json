{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:data-preparation-manifest:2.0",
  "title": "Phase B deterministic CODE-ACCORD preparation manifest",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "dataset_id",
    "archive_sha256",
    "acquisition_manifest_sha256",
    "annotation_bundle_sha256",
    "tree_hash_revision",
    "first_materialization_tree_sha256",
    "second_materialization_tree_sha256",
    "dataset_tree_sha256",
    "byte_identical_independent_materializations",
    "counts",
    "split",
    "repair_rows",
    "unresolved_alignments",
    "typed_strict_ineligible_rows",
    "typed_strict_eligible_rows",
    "typed_strict_unique_triples",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "phase-b-data-preparation-manifest-2.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "dataset_id": {"const": "CODE-ACCORD-v1.0.0"},
    "tree_hash_revision": {"const": "PHASE-B-TREE-1"},
    "byte_identical_independent_materializations": {"const": true},
    "repair_rows": {"const": 1},
    "unresolved_alignments": {"const": 9},
    "typed_strict_ineligible_rows": {"const": 9},
    "typed_strict_eligible_rows": {"const": 3320},
    "typed_strict_unique_triples": {"const": 3319},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "first_materialization_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "second_materialization_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
