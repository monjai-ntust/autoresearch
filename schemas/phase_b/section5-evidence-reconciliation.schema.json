{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:section5-evidence-reconciliation:1.0",
  "title": "Secondary Section 5 evidence reconciliation audit",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "workflow_id",
    "run_id",
    "stage",
    "status",
    "authority",
    "canonical_publication_eligible",
    "publication_execution_admitted",
    "publication_execution_gate",
    "register",
    "ledgers",
    "claim_families",
    "summary",
    "hard_stops"
  ],
  "properties": {
    "schema_version": {"const": "phase-b-section5-evidence-reconciliation-1.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "workflow_id": {"const": "PATH-A-WORKFLOW-1.3"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"const": "secondary_evidence_reconciliation"},
    "status": {"const": "reconciled_secondary_evidence"},
    "authority": {"const": "secondary_only"},
    "canonical_publication_eligible": {"const": false},
    "publication_execution_admitted": {"const": false},
    "publication_execution_gate": {"const": "B-07-go-no-go-not-yet-approved"},
    "register": {"type": "object"},
    "ledgers": {"type": "array", "minItems": 2},
    "claim_families": {"type": "array", "minItems": 1},
    "summary": {
      "type": "object",
      "required": [
        "claim_family_count",
        "support_status_counts",
        "canonical_ready_claim_family_count",
        "historical_ledgers_are_secondary_only",
        "new_measurements_must_use_canonical_framework"
      ],
      "properties": {
        "claim_family_count": {"type": "integer", "minimum": 1},
        "support_status_counts": {"type": "object"},
        "canonical_ready_claim_family_count": {"const": 0},
        "historical_ledgers_are_secondary_only": {"const": true},
        "new_measurements_must_use_canonical_framework": {"const": true}
      },
      "additionalProperties": false
    },
    "hard_stops": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
