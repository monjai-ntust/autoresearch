{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:model-train-manifest:1.0",
  "title": "Encoder training stage manifest",
  "description": "Manifest emitted by phase_b.py model train for a deterministic plan or a completed compatibility-hosted live seed.",
  "type": "object",
  "required": [
    "protocol_id",
    "matcher_id",
    "stage",
    "execution_mode",
    "status",
    "created_at_utc",
    "training_seed",
    "split",
    "recipe",
    "expected_checkpoint_dir",
    "checkpoint_manifest_contract",
    "final_test_selection_forbidden",
    "live_execution_status"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "matcher_id": {"const": "CODE-STRICT-1"},
    "stage": {"const": "model-train"},
    "execution_mode": {"enum": ["dry-run", "live"]},
    "status": {"enum": ["planned", "completed"]},
    "created_at_utc": {"type": "string"},
    "training_seed": {"type": "integer", "minimum": 42, "maximum": 49},
    "split": {"type": "object"},
    "recipe": {"type": "object"},
    "expected_checkpoint_dir": {"type": "string", "minLength": 1},
    "checkpoint_manifest_contract": {"const": "urn:phase-b:model-checkpoint-manifest:3.0"},
    "final_test_selection_forbidden": {"const": true},
    "live_execution_status": {"enum": ["gated_external_accelerator", "completed_external_accelerator"]},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "resume": {"type": "object"},
    "environment": {"type": "object"},
    "historical_comparability": {"const": "partial_match_full_legacy_equivalence_unavailable"}
  },
  "additionalProperties": false
}
