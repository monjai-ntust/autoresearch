{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:model-train-manifest:1.0",
  "title": "Encoder training stage manifest",
  "description": "Manifest emitted by phase_b.py model train. Only dry-run is implemented: it plans deterministic single-seed encoder training against the frozen recipe and declares the checkpoint-manifest contract that gated live training must satisfy.",
  "type": "object",
  "required": [
    "protocol_id",
    "matcher_id",
    "stage",
    "execution_mode",
    "status",
    "created_at_utc",
    "training_seed",
    "split",
    "recipe",
    "expected_checkpoint_dir",
    "checkpoint_manifest_contract",
    "final_test_selection_forbidden",
    "live_execution_status"
  ],
  "properties": {
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "matcher_id": {"const": "CODE-STRICT-1"},
    "stage": {"const": "model-train"},
    "execution_mode": {"const": "dry-run"},
    "status": {"const": "planned"},
    "created_at_utc": {"type": "string"},
    "training_seed": {"type": "integer", "minimum": 42, "maximum": 49},
    "split": {"type": "object"},
    "recipe": {"type": "object"},
    "expected_checkpoint_dir": {"type": "string", "minLength": 1},
    "checkpoint_manifest_contract": {"const": "urn:phase-b:model-checkpoint-manifest:1.0"},
    "final_test_selection_forbidden": {"const": true},
    "live_execution_status": {"const": "gated_external_accelerator"}
  },
  "additionalProperties": false
}
