{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:records:1.0",
  "title": "Phase B gold, candidate, and verifier records",
  "oneOf": [
    {"$ref": "#/$defs/goldRecord"},
    {"$ref": "#/$defs/candidateRecord"},
    {"$ref": "#/$defs/verdictRecord"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "object",
      "required": ["start", "end", "type"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "type": {"enum": ["Object", "Property", "Quality", "Value"]},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "triple": {
      "type": "object",
      "required": ["head", "relation", "tail"],
      "properties": {
        "head": {"$ref": "#/$defs/span"},
        "relation": {
          "enum": [
            "selection",
            "necessity",
            "part-of",
            "not-part-of",
            "equal",
            "greater",
            "greater-equal",
            "less",
            "less-equal"
          ]
        },
        "tail": {"$ref": "#/$defs/span"}
      },
      "additionalProperties": false
    },
    "inputHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "goldRecord": {
      "type": "object",
      "required": [
        "protocol_id",
        "split_id",
        "example_id",
        "source_document_id",
        "gold_triples",
        "input_hashes"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "split_id": {"const": "CODE-SPLIT-1:test"},
        "example_id": {"type": "string", "minLength": 1},
        "source_document_id": {"type": "string", "minLength": 1},
        "gold_triples": {"type": "array", "items": {"$ref": "#/$defs/triple"}},
        "input_hashes": {"$ref": "#/$defs/inputHashes"}
      },
      "additionalProperties": false
    },
    "candidateRecord": {
      "type": "object",
      "required": [
        "protocol_id",
        "split_id",
        "training_seed",
        "example_id",
        "source_document_id",
        "candidate_id",
        "head",
        "relation",
        "tail",
        "triple_confidence",
        "input_hashes"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "split_id": {"const": "CODE-SPLIT-1:test"},
        "training_seed": {"enum": [42, 43, 44, 45, 46, 47, 48, 49]},
        "example_id": {"type": "string", "minLength": 1},
        "source_document_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "pattern": "^cand-[0-9a-f]{64}$"},
        "head": {"$ref": "#/$defs/span"},
        "relation": {
          "enum": [
            "selection",
            "necessity",
            "part-of",
            "not-part-of",
            "equal",
            "greater",
            "greater-equal",
            "less",
            "less-equal"
          ]
        },
        "tail": {"$ref": "#/$defs/span"},
        "triple_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "input_hashes": {"$ref": "#/$defs/inputHashes"}
      },
      "additionalProperties": false
    },
    "verdictRecord": {
      "type": "object",
      "required": [
        "protocol_id",
        "condition_id",
        "training_seed",
        "candidate_id",
        "response_status",
        "action",
        "reason_code",
        "corrected",
        "correction_validation_status",
        "raw_response_sha256",
        "prompt_sha256",
        "model_manifest_sha256",
        "decoding_sha256",
        "attempts",
        "error_category",
        "telemetry"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "condition_id": {"enum": ["VER-SIMPLE", "VER-CORRECTIVE"]},
        "training_seed": {"enum": [42, 43, 44, 45, 46, 47, 48, 49]},
        "candidate_id": {"type": "string", "pattern": "^cand-[0-9a-f]{64}$"},
        "response_status": {
          "enum": [
            "valid_response",
            "malformed",
            "timeout_exhausted",
            "transport_exhausted",
            "schema_invalid"
          ]
        },
        "action": {"type": ["string", "null"]},
        "reason_code": {
          "oneOf": [
            {
              "enum": [
                "SUPPORTED",
                "WRONG_RELATION",
                "WRONG_HEAD",
                "WRONG_TAIL",
                "UNSUPPORTED",
                "AMBIGUOUS"
              ]
            },
            {"type": "null"}
          ]
        },
        "corrected": {"oneOf": [{"$ref": "#/$defs/triple"}, {"type": "null"}]},
        "correction_validation_status": {"type": "string"},
        "raw_response_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "model_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "decoding_sha256": {"$ref": "#/$defs/sha256"},
        "attempts": {"type": "integer", "minimum": 1},
        "error_category": {"type": ["string", "null"]},
        "telemetry": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
