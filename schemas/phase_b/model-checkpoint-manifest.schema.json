{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:model-checkpoint-manifest:3.0",
  "title": "CODE-STRICT-1 encoder checkpoint identity manifest",
  "description": "Frozen identity of the encoder checkpoint that produced a prediction ledger. It binds candidates to a training seed, the leakage-safe split, and the approved training recipe.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "split_id",
    "training_seed",
    "base_model",
    "base_model_revision",
    "checkpoint_sha256",
    "checkpoint_step",
    "split_manifest_sha256",
    "max_span_width",
    "context_between_spans",
    "archive_sha256",
    "acquisition_manifest_sha256",
    "annotation_bundle_sha256",
    "prepared_dataset_tree_sha256",
    "train_jsonl_sha256",
    "development_jsonl_sha256",
    "config_sha256",
    "trainer_sha256",
    "data_adapter_sha256",
    "model_helper_sha256",
    "model_cache_manifest",
    "model_cache_manifest_sha256",
    "model_cache_tree_sha256",
    "source_commit",
    "selected_metric",
    "selected_metric_value",
    "restart_state_sha256",
    "dataset_compatibility_report",
    "dataset_compatibility_sha256",
    "historical_comparability"
  ],
  "properties": {
    "schema_version": {"const": "phase-b-model-checkpoint-manifest-3.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "split_id": {"const": "CODE-SPLIT-1"},
    "training_seed": {"type": "integer", "minimum": 42, "maximum": 49},
    "base_model": {"const": "microsoft/deberta-large"},
    "base_model_revision": {"const": "28c23d9eb93ea6cf11f845501ab7aeb2a497658b"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_step": {"type": "integer", "minimum": 1},
    "split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_span_width": {"type": "integer", "minimum": 1},
    "context_between_spans": {"type": "boolean"},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_dataset_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "train_jsonl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "development_jsonl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trainer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_helper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_cache_manifest": {"const": "manifests/huggingface-model-cache.json"},
    "model_cache_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_cache_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selected_metric": {"const": "development_strict_triple_f1"},
    "selected_metric_value": {"type": "number", "minimum": 0, "maximum": 1},
    "restart_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_compatibility_report": {"const": "audit/model-training-dataset-compatibility.json"},
    "dataset_compatibility_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "historical_comparability": {"const": "partial_match_full_legacy_equivalence_unavailable"}
  },
  "additionalProperties": false
}
