{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:input-acquisition-manifest:1.0",
  "title": "Phase B immutable input acquisition manifest",
  "type": "object",
  "required": ["schema_version", "dataset_id", "retrieved_at_utc", "archive"],
  "properties": {
    "schema_version": {"const": "phase-b-input-acquisition-manifest-1.0"},
    "dataset_id": {"const": "CODE-ACCORD-v1.0.0"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "archive": {
      "type": "object",
      "required": ["url", "path", "bytes", "md5", "sha256", "license", "status"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"const": 101265616},
        "md5": {"const": "57e2efa465f41e2f582db62810fb50f5"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"const": "CC-BY-4.0"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
