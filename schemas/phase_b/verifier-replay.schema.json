{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:verifier-replay:1.0",
  "title": "Phase B verifier request or frozen response-ledger record",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition": {"enum": ["VER-SIMPLE", "VER-CORRECTIVE"]},
    "attempt": {
      "type": "object",
      "required": [
        "attempt",
        "started_at_utc",
        "completed_at_utc",
        "elapsed_seconds",
        "transport_status",
        "http_status",
        "raw_response",
        "raw_body_sha256"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "transport_status": {"enum": ["response", "timeout", "transport_error"]},
        "http_status": {"type": ["integer", "null"]},
        "raw_response": {"type": ["object", "null"]},
        "raw_body_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "protocol_id",
        "condition_id",
        "training_seed",
        "example_id",
        "source_document_id",
        "candidate_id",
        "candidate_sha256",
        "cache_key",
        "prompt_sha256",
        "model_manifest_sha256",
        "decoding_sha256",
        "request_sha256",
        "payload"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "condition_id": {"$ref": "#/$defs/condition"},
        "training_seed": {"enum": [42, 43, 44, 45, 46, 47, 48, 49]},
        "example_id": {"type": "string", "minLength": 1},
        "source_document_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "pattern": "^cand-[0-9a-f]{64}$"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "cache_key": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "model_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "decoding_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "protocol_id",
        "condition_id",
        "candidate_id",
        "cache_key",
        "cache_hit",
        "attempts"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "condition_id": {"$ref": "#/$defs/condition"},
        "candidate_id": {"type": "string", "pattern": "^cand-[0-9a-f]{64}$"},
        "cache_key": {"$ref": "#/$defs/sha256"},
        "cache_hit": {"type": "boolean"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/attempt"}
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}]
}
