{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:gold-alignment-audit:1.0",
  "title": "Phase B CODE-STRICT-1 gold alignment hard-stop audit",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "dataset_id",
    "status",
    "policy",
    "summary",
    "decision",
    "issues"
  ],
  "properties": {
    "schema_version": {"const": "phase-b-gold-alignment-audit-1.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "dataset_id": {"const": "CODE-ACCORD-v1.0.0"},
    "status": {"const": "hard_stop"},
    "policy": {"const": "unique-typed-bio-span-by-canonical-position-1.0"},
    "summary": {
      "type": "object",
      "required": [
        "relation_rows_scanned",
        "positive_relation_rows_scanned",
        "none_relation_rows_scanned",
        "accepted_uuid_repair_rows",
        "marker_arguments_scanned",
        "exact_span_alignments",
        "marker_contained_in_typed_span_alignments",
        "unresolved_marker_arguments",
        "affected_positive_relation_rows",
        "affected_sentence_ids",
        "affected_rows",
        "affected_ids",
        "unresolved_categories",
        "official_entity_partitions"
      ],
      "properties": {
        "relation_rows_scanned": {"type": "integer", "minimum": 0},
        "positive_relation_rows_scanned": {"type": "integer", "minimum": 0},
        "none_relation_rows_scanned": {"type": "integer", "minimum": 0},
        "accepted_uuid_repair_rows": {"type": "integer", "minimum": 0},
        "marker_arguments_scanned": {"type": "integer", "minimum": 0},
        "exact_span_alignments": {"type": "integer", "minimum": 0},
        "marker_contained_in_typed_span_alignments": {"type": "integer", "minimum": 0},
        "unresolved_marker_arguments": {"type": "integer", "minimum": 1},
        "affected_positive_relation_rows": {"type": "integer", "minimum": 1},
        "affected_sentence_ids": {"type": "integer", "minimum": 1},
        "affected_rows": {"type": "array", "items": {"type": "integer", "minimum": 2}, "uniqueItems": true},
        "affected_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
        "unresolved_categories": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "official_entity_partitions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    },
    "decision": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "annotation_row",
          "example_id",
          "official_entity_partition",
          "entity_annotation_row",
          "relation",
          "marker_role",
          "marker_text",
          "canonical_character_start",
          "canonical_character_end_exclusive",
          "category",
          "overlapping_typed_bio_spans",
          "authoritative_typed_bio_spans",
          "tagged_sentence"
        ],
        "properties": {
          "annotation_row": {"type": "integer", "minimum": 2},
          "example_id": {"type": "string", "format": "uuid"},
          "official_entity_partition": {"enum": ["train", "test", "unknown"]},
          "entity_annotation_row": {"type": "integer", "minimum": 2},
          "relation": {"type": "string"},
          "marker_role": {"enum": ["head", "tail"]},
          "marker_text": {"type": "string", "minLength": 1},
          "canonical_character_start": {"type": "integer", "minimum": 0},
          "canonical_character_end_exclusive": {"type": "integer", "minimum": 1},
          "category": {"enum": ["multiple_bio_spans_overlap", "partial_single_bio_span_overlap", "no_bio_span_overlap"]},
          "overlapping_typed_bio_spans": {"type": "array"},
          "authoritative_typed_bio_spans": {"type": "array"},
          "tagged_sentence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
