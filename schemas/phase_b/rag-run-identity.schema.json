{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-run-identity.schema.json",
  "title": "Immutable Graph RAG staged-run identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_group_id",
    "config_sha256",
    "adapter",
    "checkpoint_sha256",
    "source_surface_sha256",
    "source_surface",
    "schema_set_sha256",
    "schemas"
  ],
  "properties": {
    "schema_version": {"const": "rag-run-identity-1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "experiment_group_id": {"type": ["string", "null"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "import_path",
        "options_sha256"
      ],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "import_path": {"type": "string", "minLength": 1},
        "options_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checkpoint_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_surface_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_surface": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "schema_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
