{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:section5-evidence-register:2.0",
  "title": "Frozen secondary Section 5 evidence register",
  "type": "object",
  "required": [
    "register_revision",
    "protocol_id",
    "workflow_id",
    "authority",
    "canonical_publication_eligible",
    "ledgers",
    "claim_families"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "register_revision": {"const": "SECTION5-EVIDENCE-2.0"},
    "protocol_id": {"const": "B04-PATH-A-1.3"},
    "workflow_id": {"const": "PATH-A-WORKFLOW-1.3"},
    "authority": {"const": "secondary_only"},
    "canonical_publication_eligible": {"const": false},
    "ledgers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "archival_status",
          "source_checkout_bytes",
          "source_checkout_sha256",
          "source_git_blob",
          "source_newline_style",
          "normalized_lf_bytes",
          "normalized_lf_sha256",
          "line_count",
          "ends_with_newline",
          "has_header",
          "nominal_field_count",
          "structural_status",
          "expected_structure"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "archival_status": {"const": "hash_verified_external_archive"},
          "source_checkout_bytes": {"type": "integer", "minimum": 1},
          "source_checkout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_newline_style": {"enum": ["lf", "crlf"]},
          "normalized_lf_bytes": {"type": "integer", "minimum": 1},
          "normalized_lf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "line_count": {"type": "integer", "minimum": 1},
          "ends_with_newline": {"type": "boolean"},
          "has_header": {"type": "boolean"},
          "nominal_field_count": {"type": "integer", "minimum": 1},
          "structural_status": {"type": "string", "minLength": 1},
          "expected_structure": {
            "type": "object",
            "required": ["blank_lines", "field_count_histogram", "concatenated_record_lines"],
            "properties": {
              "blank_lines": {"type": "array", "items": {"type": "integer", "minimum": 1}},
              "field_count_histogram": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 1}
              },
              "concatenated_record_lines": {"type": "array", "items": {"type": "integer", "minimum": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "claim_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "draft_scope",
          "support_status",
          "canonical_eligible",
          "ledger_references",
          "absence_queries",
          "limitations",
          "canonical_next_action"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^S5-[1-5]-[A-Z0-9-]+$"},
          "draft_scope": {"type": "string", "minLength": 1},
          "support_status": {"type": "string", "minLength": 1},
          "canonical_eligible": {"const": false},
          "ledger_references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "line", "contains_all"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "contains_all": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              },
              "additionalProperties": false
            }
          },
          "absence_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"pattern": "^DISC-[0-9]{3}$"}},
          "canonical_next_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
