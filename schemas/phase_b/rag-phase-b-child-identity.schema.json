{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-phase-b-child-identity.schema.json",
  "title": "Immutable Phase B Graph RAG child identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "protocol_id",
    "parent",
    "config",
    "source_surface_sha256",
    "source_surface",
    "schema_set_sha256",
    "schemas"
  ],
  "properties": {
    "schema_version": {"const": "rag-phase-b-child-identity-1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "protocol_id": {"const": "C-04-PHASE-B-REGIME-D-1.0"},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "workflow_id",
        "matcher_id",
        "score_manifest_sha256",
        "artifact_set_sha256"
      ],
      "properties": {
        "protocol_id": {"const": "B04-PATH-A-1.3"},
        "workflow_id": {"const": "PATH-A-WORKFLOW-1.3"},
        "matcher_id": {"const": "CODE-STRICT-1"},
        "score_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_surface": {"type": "array"},
    "schema_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemas": {"type": "array"}
  }
}
