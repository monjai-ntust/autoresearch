{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase-b:huggingface-cache:1.0",
  "title": "Run-local Hugging Face model/tokenizer cache",
  "type": "object",
  "required": [
    "schema_version",
    "model",
    "revision",
    "cache_root",
    "file_count",
    "tree_sha256",
    "files",
    "offline_replay_ready"
  ],
  "properties": {
    "schema_version": {"const": "phase-b-huggingface-cache-1.0"},
    "model": {"const": "microsoft/deberta-large"},
    "revision": {"const": "28c23d9eb93ea6cf11f845501ab7aeb2a497658b"},
    "cache_root": {"const": "inputs/huggingface"},
    "file_count": {"type": "integer", "minimum": 1},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["file", "symlink"]},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "offline_replay_ready": {"const": true}
  },
  "additionalProperties": false
}
