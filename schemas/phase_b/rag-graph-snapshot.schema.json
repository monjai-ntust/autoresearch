{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-graph-snapshot.schema.json",
  "title": "Graph snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "graph_id",
    "condition",
    "entities",
    "relations",
    "triples",
    "descriptor_sha256",
    "corpus_sha256",
    "adapter_sha256",
    "extractor_sha256",
    "entity_sha256",
    "relation_sha256",
    "triple_sha256",
    "construction_recipe",
    "schema_version"
  ],
  "properties": {
    "dataset_id": {"type": "string"},
    "graph_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition": {"type": "string"},
    "entities": {"type": "array"},
    "relations": {"type": "array"},
    "triples": {"type": "array"},
    "descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "triple_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "construction_recipe": {"type": "string"},
    "parent_graph_id": {"type": ["string", "null"]},
    "corruption_recipe": {"type": ["object", "null"]},
    "schema_version": {"const": "rag-graph-snapshot-1.0"},
    "construction_time": {"type": "string"}
  }
}
